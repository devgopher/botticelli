  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Botticelli.Chained.Monads\Botticelli.Chained.Monads.csproj" />
